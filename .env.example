# Port, auf dem der Server laeuft
PORT=3000

# Passwort fuer den Admin-/Backend-Bereich (unbedingt aendern!)
ADMIN_PASSWORD=bitte-aendern

# Zufaelliger, geheimer String zum Signieren der Admin-Session (z. B. mit
# `openssl rand -hex 32` erzeugen)
SESSION_SECRET=bitte-durch-zufaelligen-wert-ersetzen

# Globaler n8n-Webhook, an den Anforderungen gesendet werden, wenn ein
# einzelnes Programm keinen eigenen Webhook hinterlegt hat.
N8N_WEBHOOK_URL=https://n8n.beispiel-stadt.de/webhook/software-marktplatz-anforderung
